root ::= thought action args

thought ::= "Thought: " [^\n]+ "\n"
action  ::= "Action: " tool_name "\n"
args    ::= "Args: " json_object

tool_name ::= ("query_weighing_data" | "detect_anomalies" | "send_sms_alert" | "none")

json_object ::= "{" ws ( pair ( "," ws pair )* )? "}"
pair        ::= string ":" ws value
value       ::= string | number | "true" | "false" | "null"
string      ::= "\"" [^\"]* "\""
number      ::= [0-9]+ ("." [0-9]+)?
ws          ::= [ \t\n\r]*